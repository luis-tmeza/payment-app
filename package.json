{
  "name": "payment-app",
  "private": true,
  "version": "0.1.0",
  "description": "Payment checkout technical test monorepo",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @payment-app/backend --filter @payment-app/frontend dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @payment-app/backend prisma:migrate:deploy",
    "db:seed": "pnpm --filter @payment-app/backend prisma:seed",
    "setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
